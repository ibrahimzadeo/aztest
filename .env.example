# Copy to .env for local runs; in Coolify set these as environment variables.
POSTGRES_PASSWORD=aztestlocalpw          # alphanumeric only — special chars break the URL
ENCRYPTION_KEY=change-me-any-passphrase  # encrypts the provider key stored by the UI
AZTEST_API_KEY=                          # shared UI/API key; empty disables auth (local only)
CORS_ORIGINS=*

# Baked into the web bundle at build time (Coolify: Build Variable).
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_PROVIDER_LABEL=nexum router

# Optional first-boot fallbacks; the UI stores the real values in the DB.
NEXUM_BASE_URL=https://dialagram.me/router/v1
NEXUM_API_KEY=
JUDGE_MODEL=
MAX_CONCURRENCY=3
